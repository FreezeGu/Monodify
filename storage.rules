rules_version = '2';

// ============================================
// STORAGE SECURITY RULES
// ============================================
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.admin == true;
    }
    
    // ========== NASHEEDS STORAGE ==========
    // Public read for all nasheeds (for playback)
    // Authenticated users can upload to their own folder
    // Users can delete their own files
    // Admins can delete any files
    match /nasheeds/{userId}/{allPaths=**} {
      // Public read - anyone can access nasheed audio/images for playback
      allow read: if true;
      
      // Users can upload to their own folder
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Users can delete their own files
      // Admins can delete any files
      allow delete: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin()
      );
    }
    
    // ========== USER FILES STORAGE ==========
    // Users can manage their own files (profile pictures, etc.)
    match /users/{userId}/{allPaths=**} {
      // Authenticated users can read user files
      allow read: if request.auth != null;
      
      // Users can upload to their own folder
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Users can delete their own files
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ========== ADMIN FILES (if needed) ==========
    // Admins can manage admin-specific files
    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
