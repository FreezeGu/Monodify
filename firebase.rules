rules_version = '2';

// ============================================
// FIRESTORE SECURITY RULES
// ============================================
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // ========== USERS COLLECTION ==========
    // Users can read any profile (for public profiles, following, etc.)
    // Users can write only their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ========== NASHEEDS COLLECTION ==========
    // Public read for approved nasheeds (anyone can browse/listen)
    // Authenticated users can create nasheeds (upload)
    // Only admins can approve/reject nasheeds
    // Users can update their own pending nasheeds
    match /nasheeds/{nasheedId} {
      // Anyone can read approved nasheeds
      // Authenticated users can read pending/rejected (to see their own uploads)
      allow read: if resource.data.status == 'approved' || 
                     (request.auth != null && request.auth.uid == resource.data.uploadedBy);
      
      // Authenticated users can create nasheeds
      allow create: if request.auth != null && 
                       request.resource.data.uploadedBy == request.auth.uid &&
                       request.resource.data.status == 'pending';
      
      // Users can update their own pending nasheeds
      // Admins can update any nasheed (approve/reject)
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.uploadedBy && resource.data.status == 'pending') ||
        isAdmin()
      );
      
      // Only admins can delete nasheeds
      allow delete: if isAdmin();
    }
    
    // ========== PLAYLISTS COLLECTION ==========
    // Public playlists are readable by all authenticated users
    // Private playlists are readable only by owner
    // Users can create and manage their own playlists
    match /playlists/{playlistId} {
      // Public playlists: readable by all authenticated users
      // Private playlists: readable only by owner
      allow read: if request.auth != null && (
        resource.data.public == true || 
        resource.data.userId == request.auth.uid
      );
      
      // Users can create playlists (must set userId to their own)
      allow create: if request.auth != null && 
                       request.resource.data.userId == request.auth.uid;
      
      // Users can update/delete their own playlists
      allow update, delete: if request.auth != null && 
                               resource.data.userId == request.auth.uid;
    }
    
    // ========== LIKES COLLECTION (if you add this feature) ==========
    // Users can like/unlike nasheeds
    match /likes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                       request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && 
                       resource.data.userId == request.auth.uid;
    }
    
    // ========== COMMENTS COLLECTION (if you add this feature) ==========
    // Users can comment on nasheeds
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                       request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && 
                               resource.data.userId == request.auth.uid;
    }
  }
}

// ============================================
// STORAGE SECURITY RULES
// ============================================
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.admin == true;
    }
    
    // ========== NASHEEDS STORAGE ==========
    // Public read for all nasheeds (for playback)
    // Authenticated users can upload to their own folder
    // Users can delete their own files
    // Admins can delete any files
    match /nasheeds/{userId}/{allPaths=**} {
      // Public read - anyone can access nasheed audio/images for playback
      allow read: if true;
      
      // Users can upload to their own folder
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Users can delete their own files
      // Admins can delete any files
      allow delete: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin()
      );
    }
    
    // ========== USER FILES STORAGE ==========
    // Users can manage their own files (profile pictures, etc.)
    match /users/{userId}/{allPaths=**} {
      // Authenticated users can read user files
      allow read: if request.auth != null;
      
      // Users can upload to their own folder
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Users can delete their own files
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ========== ADMIN FILES (if needed) ==========
    // Admins can manage admin-specific files
    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
